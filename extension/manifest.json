{
  "manifest_version": 3,
  "name": "PlanWise",
  "version": "0.2.0",
  "description": "Detects plans in messages you type and adds them to your calendar. Only reads your own compose box - never other people's messages.",
  "permissions": [
    "storage",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://web.telegram.org/*",
    "https://mail.google.com/*",
    "https://*.supabase.co/*"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://mail.google.com/*"
      ],
      "js": [
        "utils/storage.js",
        "utils/logger.js",
        "detection/rules.js",
        "detection/engine.js",
        "detection/extractor.js",
        "content/text-buffer.js",
        "content/dom-observer.js",
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PlanWise"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/supabase.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
